  "version": "4.6.0",
  "type": "module",
  "description": "Knife4j UI for OpenAPI 3 based on Vue3 + Vite",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:SpringDocOpenApi": "cross-env VITE_RELEASE_APP_TYPE=SpringDocOpenApi vite build",
    "build:Knife4jSpringUi": "cross-env VITE_RELEASE_APP_TYPE=Knife4jSpringUi vite build",
    "build:Knife4jJFinal": "cross-env VITE_RELEASE_APP_TYPE=Knife4jJFinal vite build",
    "build:Knife4jFront": "cross-env VITE_RELEASE_APP_TYPE=Knife4jFront vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^6.1.0",
    "@babel/generator": "^7.29.13",
    "ace-builds": "^1.45.2",
    "ant-design-vue": "^3.2.20",
    "ast-types": "^0.16.3",
    "async": "^3.2.6",
    "axios": "^1.21.1",
    "clipboard": "^2.0.11",
    "js-md5": "^0.9.2",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "marked": "^18.2.0",
    "mermaid": "^12.3.0",
    "pinia": "^3.0.4",
    "qs": "^6.17.1",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
